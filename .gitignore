data/

# Logs
logs/
*.log

# Backup
*.backup
*.bak
*.bkp

# Forge audit
forge-audit-*.md

# Arms
arms/

# Evolution
.evolution/
evolution-log.md
self-improving-log.md
HEARTBEAT.md

# Internal work files — NOT for public repository
HAMMER_TASK.md
_audit_runner.py
.forge_test_instructions

