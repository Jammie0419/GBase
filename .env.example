# ── GBase v0.7.0 Environment Configuration ──
# Copy this file to .env and fill in your API keys.

# ── LLM Providers ──
# Alibaba Cloud (DashScope) — default provider for qwen models
GBASE_ALIYUN_API_KEY=your_aliyun_key_here

# MiniMax — alternative provider
OPPRIME_MINIMAX_API_KEY=

# DeepSeek — alternative provider
OPPRIME_DEEPSEEK_API_KEY=

# ── Model Configuration ──
# Model alias: pro / flash / ds / minimax (or full model name)
OPPRIME_MODEL=pro

# ── Feishu Bot (optional) ──
OPPRIME_FEISHU_APP_ID=
OPPRIME_FEISHU_APP_SECRET=
OPPRIME_FEISHU_ENCRYPT_KEY=
OPPRIME_FEISHU_VERIFY_TOKEN=

# Legacy Feishu config (v0.5.1 style, also supported)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_PORT=8440

# ── Identity ──
IDENTITY=default

# ── GBase Mode ──
# enterprise: preserve all data (IMPORTANCE_FLOOR=0.0, MAX_SESSION_ROWS=100000)
# lite: aggressive pruning (IMPORTANCE_FLOOR=0.15, MAX_SESSION_ROWS=15)
GBASE_MODE=enterprise

# ── Directory Overrides ──
# GBASE_DATA_DIR=./data
# GBASE_LOG_DIR=./data/logs
# GBASE_ROOT_DIR=.
# GBASE_EVOLUTION_DIR=./.evolution

# ── Edition ──
# hacker / prime / standard / lite
GBASE_EDITION=hacker

# ── Village OS (optional, multi-agent) ──
# VILLAGE_OS_URL=http://localhost:9000

# ── Autonomous Learning ──
# OPPRIME_LEARN_OWNER=

# ── Skills Directory ──
# OPPRIME_SKILLS_DIR=skills
